# Hidden files/dirs — strict policy: keep them out
.*
!.gitignore
!.gitattributes
# Tier-4 4.4: CI workflows live under .github/ (hidden); explicit allow
!.github/
!.github/**

node_modules/
.DS_Store
.vscode/
vendor/
*.log
TBD/daemon/target/release/

# Environment Configuration
.env
.env.*
*.so
# Runtime Files
/logs/*
/cache/*
/build/*
/target/
# System Files
Thumbs.db

# macOS system files
.DS_Store
.AppleDouble
.LSOverride

# Icon must end with two \r
Icon

# Thumbnails
._*

# Files that might appear in the root of a volume
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent

# Directories potentially created on remote AFP share
.AppleDB
.AppleDesktop
Network Trash Folder
Temporary Items
.apdisk

# WordPress specific files
wp-config.php
wp-content/advanced-cache.php
wp-content/backup-db/
wp-content/backups/
wp-content/blogs.dir/
wp-content/cache/
wp-content/upgrade/
wp-content/uploads/
wp-content/mu-plugins/
wp-content/wp-cache-config.php
wp-content/plugins/hello.php

# Log files
*.log

# htaccess
/.htaccess

# Editor files
*.sublime-project
*.sublime-workspace
*.komodoproject
.vscode/*

# Node modules
node_modules/

# Compiled CSS (if you're using a CSS preprocessor)
*.css.map

# Compiled JavaScript
*.js.map

# PHP Composer
vendor/
/archive/
/valkey-data/

# Temporary files
*.tmp
*.bak
*.swp
lib/libgeometric_topology.so
/Geo/
# Local archive folder
.archive/
# Claude Code local settings (may contain credentials)
.claude/
# Internal development documents (not for public release)
/internals/
CLAUDE.md
docs/missions/
# Auto-deploy logs
logs/

# Compiled config (generated by scripts/compile-config.php)
config/compiled.php

# Internal session/handoff documents (not for public release)
CLAUDE.md
*.scn.md
# …except the permanent contract primer, which is tracked alongside CONTRACT.md
!CONTRACT.scn.md
SESSION_*.md
MISSION_*.md
AUDIT_*.md
/internals/

# Optional extension package repos (separate git repos)
gCore-Ecommerce/

# Geodineum security — web-deny rules must be tracked
!**/.htaccess
!**/nginx-deny.conf
/reference-llms/
