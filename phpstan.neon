includes:
    - phpstan-baseline.neon

parameters:
    level: 6
    phpVersion: 80000
    paths:
        - Modules
    excludePaths:
        analyseAndScan:
            - Modules/*/Templates/*
    bootstrapFiles:
        - vendor/autoload.php
    treatPhpDocTypesAsCertain: false
    reportUnmatchedIgnoredErrors: false
