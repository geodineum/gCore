{
    "name": "geodineum/gcore",
    "description": "Distributed PHP framework with geometric topology service discovery and ValKey state management",
    "type": "library",
    "license": "(MIT OR Apache-2.0)",
    "authors": [
        {
            "name": "Niels Erik Toren",
            "email": "dev@geodineum.com",
            "homepage": "https://geodineum.com"
        }
    ],
    "require": {
        "php": ">=7.4",
        "ext-json": "*",
        "ext-redis": "^5.2",
        "ext-mbstring": "*",
        "ext-igbinary": "^3.0",
        "ext-zlib": ">=1.2"
    },
    "suggest": {
        "gcore/gnode-client": "Required for gNode daemon integration (distributed streams, topology engine)"
    },
    "autoload": {
        "psr-4": {
            "gCore\\Modules\\": "Modules/"
        },
        "files": [
            "Modules/Managers/Stubs/register.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "gCore\\Tests\\": "tests/"
        }
    },
    "require-dev": {
        "phpstan/phpstan": "^1.11",
        "szepeviktor/phpstan-wordpress": "^1.3",
        "phpstan/extension-installer": "^1.3"
    },
    "config": {
        "allow-plugins": {
            "phpstan/extension-installer": true
        }
    },
    "scripts": {
        "analyse": "phpstan analyse --memory-limit=2G",
        "analyse:baseline": "phpstan analyse --generate-baseline --memory-limit=2G"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
